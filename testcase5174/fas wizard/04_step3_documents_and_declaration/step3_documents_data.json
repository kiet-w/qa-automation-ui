{
  "test_environments": {
    "portal_url": "http://localhost:5174",
    "fas_application_route": "/fas-application",
    "step3_heading": "Commitment and Declarations"
  },
  "locators": {
    "FILE_INPUT": "input[type='file'], input[data-testid='input-supporting-doc']",
    "DROPZONE": "div[data-testid='dropzone-documents'], div[class*='dropzone']",
    "FILE_ITEMS": "li[data-testid^='doc-file-item-'], div[class*='fileItem']",
    "REMOVE_FILE_BTN": "button[data-testid^='btn-remove-doc-'], button:has-text('Remove file'), button[aria-label*='Remove']",
    "FILE_ERROR_MSG": "div[class*='fileError'], p[role='alert']",
    "COMMITMENT_CHECKBOX": "input#applicant-commitmentAgreed",
    "FORWARD_TO_SCHOOL_CHECKBOX": "input#applicant-forwardToSchoolAgreed",
    "COMMITMENT_ERROR": "label:has(#applicant-commitmentAgreed) ~ p, p[class*='error'], #applicant-commitmentAgreed-error",
    "CONTEXT_TEXTAREA": "textarea#applicant-context, textarea[name='circumstancesContext'], textarea[name*='context']",
    "CONTEXT_COUNTER": "span[data-testid='counter-context'], span:has-text('/2000')",
    "BACK_BUTTON": "button:has-text('Back'), button:has-text('Previous')",
    "NEXT_BUTTON": "button:has-text('Next'), button:has-text('Save & Continue')",
    "STEP_HEADING": "h2:has-text('Review'), #review-heading, h3:has-text('Commitment')"
  },
  "test_data": {
